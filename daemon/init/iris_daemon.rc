# Installed to /system/etc/init/ by Android.bp (init_rc). Needs the "iris"
# AID and sepolicy/iris_daemon.te from this directory in the OS tree.
#
# Directory layout (all owned by iris, created by init so no app needs
# write access to /data/misc/iris):
#   tokens/  one <package>.conf per registered app, written by irisd itself
#            in response to REGISTER on the control socket
#   bin/     signed irisd update (irisd, irisd.sig, irisd.ver), written by
#            irisd in response to INSTALL; the image copy execs it at start
#
# `socket` makes init create /dev/socket/iris_daemon before irisd runs and
# hand it over as ANDROID_SOCKET_iris_daemon. It is 0666 on purpose: the Iris
# app runs as its own platform_app uid (not system, not in group iris), so
# DAC can't single it out - access is restricted by SELinux instead
# (see sepolicy/iris_app.te).
#
# Not oneshot: when irisd exits (crash, or the RELOAD command after an
# update) init restarts it and the new binary is picked up.

on post-fs-data
    mkdir /data/misc/iris 0771 iris iris
    mkdir /data/misc/iris/tokens 0770 iris iris
    mkdir /data/misc/iris/bin 0750 iris iris
    restorecon_recursive /data/misc/iris

service iris_daemon /system/bin/irisd
    class core
    user iris
    group iris inet
    socket iris_daemon stream 0666 iris iris
    seclabel u:r:iris_daemon:s0
    writepid /dev/cpuset/system-background/tasks

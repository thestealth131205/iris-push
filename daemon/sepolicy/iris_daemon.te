# Skeleton SELinux domain for irisd. This is a starting point, not a
# verified policy - macro names/availability vary slightly across AOSP
# versions and OEM forks. After flashing, drive the final version with
# `dmesg | grep avc.*denied` + `audit2allow` during real use (daemon start,
# REGISTER, a push round-trip, an INSTALL+RELOAD) rather than trusting this
# file blindly. See OS_INTEGRATION_PLAN.md Tier 2, step 3.

type iris_daemon, domain;
type iris_daemon_exec, exec_type, file_type;

# Standard boilerplate for anything started by init via a `service` block.
init_daemon_domain(iris_daemon)

# Outbound TLS connections to Iris server(s).
net_domain(iris_daemon)
allow iris_daemon self:tcp_socket create_stream_socket_perms;
allow iris_daemon self:udp_socket create_socket_perms; # DNS resolution

# CA bundle for certificate validation.
r_dir_file(iris_daemon, system_file)

# Per-app config files (tokens/), written by irisd on REGISTER, read back
# on start; the directory is watched via inotify.
type iris_data_file, file_type, data_file_type;
allow iris_daemon iris_data_file:dir create_dir_perms;
allow iris_daemon iris_data_file:file create_file_perms;

# Signed daemon update (bin/): written by irisd on INSTALL, exec'd by the
# image copy of irisd at start (no domain transition: same domain).
#
# VERIFY IN THE TREE: AOSP's domain.te carries neverallow rules against
# executing files from data partitions. This tree is ours, so the fix is to
# exempt iris_daemon / iris_update_file in those neverallow lines (and
# keep the Ed25519 signature check in irisd.c as the real gate); do not
# widen anything else. If that proves unacceptable, the fallback is a
# dedicated /product/bin/irisd that only the OS image can replace.
type iris_update_file, file_type, data_file_type;
allow iris_daemon iris_update_file:dir create_dir_perms;
allow iris_daemon iris_update_file:file { create_file_perms execute execute_no_trans map };

# The control socket itself (init creates the sock file; irisd accepts on
# the inherited fd).
type iris_daemon_socket, file_type;
allow iris_daemon iris_daemon_socket:sock_file { create setattr unlink write };
allow iris_daemon self:unix_stream_socket { create_stream_socket_perms listen accept };

# Direct delivery (irisd >= 1.3.0): each push is handed to the target app via
# exec of /system/bin/cmd -> "activity broadcast" (see deliver_broadcast() in
# irisd.c), so the app is woken by ActivityManager like an FCM client and the
# Iris app doesn't have to relay anything. If these are denied, irisd falls
# back to the IrisBridgeService socket path automatically - check dmesg for
# avc denials of iris_daemon against system_server/activity_service.
allow iris_daemon system_file:file { execute execute_no_trans };
binder_use(iris_daemon)
binder_call(iris_daemon, system_server)
binder_call(system_server, iris_daemon) # cmd's ShellCallback/ResultReceiver
allow iris_daemon activity_service:service_manager find;
allow system_server iris_daemon:fd use;
